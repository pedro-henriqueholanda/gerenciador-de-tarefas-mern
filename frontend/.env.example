# URL base da API do backend (Express). Termina em /api, sem barra no final.
# Local: o backend roda na porta 3000.
# Codespaces: use a URL pública da porta 3000 (aba PORTS), por exemplo
#   https://<nome-do-codespace>-3000.app.github.dev/api
VITE_API_URL=http://localhost:3000/api

# Modo demonstração: true usa dados simulados e não precisa do backend.
# Deixe false para usar a API real.
VITE_USE_MOCK=false
